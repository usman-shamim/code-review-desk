# Copy to .env and fill in. .env is gitignored (NFR-1); this file is committed.
#
# The Desk fails at startup with one sentence if OPENAI_API_KEY is absent — never a traceback.

OPENAI_API_KEY=

# Optional: the model used for the FR-7 run-level override. Leave unset to use the default below.
# DESK_CHEAP_MODEL=gpt-5-mini

# Optional: the turn ceiling for every review. Defaults to 8 (see plan.md, Decided Numbers).
# DESK_MAX_TURNS=8
